# PostgreSQL parameters
# For a list of available parameters see: https://hub.docker.com/_/postgres.
POSTGRES_USER=ctr
POSTGRES_PASSWORD=dbpassword
POSTGRES_DB=ctr
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django website credentials
# Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
# "django" is the hostname the frontend container uses to reach the API
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ---- Target: Elecrow CrowPanel Advanced 5" ESP32-P4 (chip rev v1.x) ----
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# ---- Flash / partitions ----
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- PSRAM (frame buffers live here) ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_64B=y

# ---- Build for speed ----
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ---- FreeRTOS ----
CONFIG_FREERTOS_HZ=1000

# ---- RGB LCD: keep ISR running while flash cache is disabled ----
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y

# ---- LVGL ----
CONFIG_LV_COLOR_DEPTH_16=y
# LVGL allocates from the system heap (PSRAM for big blocks, e.g. TTF glyph cache)
CONFIG_LV_USE_CLIB_MALLOC=y
# Bold display font rendered at runtime from an embedded TTF
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_TINY_TTF_CACHE_GLYPH_CNT=96
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_USE_PERF_MONITOR=n
# screenshots over serial (serial_cmd "snap")
CONFIG_LV_USE_SNAPSHOT=y

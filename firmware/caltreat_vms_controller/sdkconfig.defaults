# ---- Target: Waveshare ESP32-S3-RGB-Matrix (ESP32-S3-WROOM-2-N32R16V) ----
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ---- Flash / partitions: 32 MB octal flash ----
CONFIG_ESPTOOLPY_OCT_FLASH=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- PSRAM: 16 MB octal ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# ---- Console on UART0 (TX GPIO43, RX GPIO44) ----
# The USB-C port's GPIO19/20 are taken by the USB host for the Ethernet adapter (usb_eth), which switches
# the PHY away from USB-Serial-JTAG.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ---- FreeRTOS: 1 ms ticks for the 4 ms frame loop ----
CONFIG_FREERTOS_HZ=1000

# ---- HUB75 library without Adafruit GFX (NO_GFX) ----
CONFIG_ESP32_HUB75_USE_GFX=n

# ---- Network OTA (net_ota) ----
# A new image boots as PENDING_VERIFY and rolls back unless it confirms itself
# (net_ota_mark_valid, once it has an IP).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# httpd (OTA) + backend HTTPS client + DNS + mDNS
CONFIG_LWIP_MAX_SOCKETS=16
# Cloud Run backend over HTTPS
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
# TLS buffers in PSRAM: internal RAM is taken by the HUB75 DMA buffers and the USB host
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

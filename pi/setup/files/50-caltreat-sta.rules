// Installed by Caltreat's pi/setup/network.sh: the app's user (@APP_USER@) may start caltreat-sta@on.service or
// caltreat-sta@off.service (turn the Pi's Wi-Fi client on / off) and nothing else.
polkit.addRule(function (action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" && subject.user == "@APP_USER@" &&
      action.lookup("verb") == "start" &&
      (action.lookup("unit") == "caltreat-sta@on.service" || action.lookup("unit") == "caltreat-sta@off.service")) {
    return polkit.Result.YES;
  }
});
